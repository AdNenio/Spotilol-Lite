    <string name="battery_dialog_reassure">Spotilol sigue ahorrando batería: solo funciona mientras estás escuchando música.</string>
    <string name="battery_dialog_hint">Android abrirá la pantalla de batería del sistema. Solo tienes que seleccionar «Permitir».</string>
